# Flight Fitness project only (ref gdenhlzrvxsekdfzulii) — not petmoji / other org projects.
EXPO_PUBLIC_SUPABASE_URL=https://gdenhlzrvxsekdfzulii.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Local scripts only (seed:wger) — never ship in the Expo app.
SUPABASE_URL=https://gdenhlzrvxsekdfzulii.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional / unused: exercise catalog is bundled RepDB (assets/repdb). Kept if you re-enable WorkoutX.
# EXPO_PUBLIC_WORKOUTX_API_KEY=wx_your_workoutx_api_key

# PostHog (FlightFitness project) — Project settings → Project API key (phc_...).
# Optional host override (default https://us.i.posthog.com; use https://eu.i.posthog.com for EU).
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_project_api_key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat public iOS SDK key (from RevenueCat → Project → API keys). Required for App Store IAP review.
# Set EXPO_PUBLIC_REVENUECAT_IOS_API_KEY in EAS production env — purchases fail in review if missing.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_appl_or_test_public_key

# Optional: entitlement id (default Flight Fitness Essentials) and RevenueCat package ids.
# EXPO_PUBLIC_REVENUECAT_ESSENTIALS_ENTITLEMENT_ID=Flight Fitness Essentials
# EXPO_PUBLIC_REVENUECAT_MONTHLY_PACKAGE_ID=rc_monthly
# EXPO_PUBLIC_REVENUECAT_LIFETIME_PACKAGE_ID=rc_lifetime
# EXPO_PUBLIC_REVENUECAT_WEEKLY_PACKAGE_ID=rc_weekly

# Faith tab “Load full passage” uses https://bible-api.com (WEB, public domain) — no key required.

# --- Supabase project setup (Dashboard / CLI) ---
# 1) Authentication → Providers → enable Anonymous sign-ins (required for plan + daily hero).
# 2) Edge Function secrets (never put these in the Expo app):
#    supabase secrets set OPENAI_API_KEY=sk-... SERVICE_ROLE_KEY=eyJ... CRON_SECRET=<random>
#    (Do not use the SUPABASE_ prefix for custom secrets — it is reserved.)
#    Daily hero cron also needs the same CRON_SECRET in private.cron_config (see
#    supabase/migrations/20260710210000_fix_daily_content_cron_config.sql).
#    Without that row, pg_cron fires but cannot call the edge function.
# 4) Auth email (Loops SMTP): node scripts/setup-supabase-auth-email.mjs
#    Sets smtp.loops.so + Magic Link / Confirm signup JSON templates on gdenhlzrvxsekdfzulii.
#    Optional fallback: node scripts/setup-supabase-auth-email.mjs --with-hook
#    then supabase functions deploy send-email --project-ref gdenhlzrvxsekdfzulii
#    Verify hilo-media.com in Loops (Settings → Domains). Auth mail uses growth@hilo-media.com (not hello@).
#    After changing sender: LOOPS_API_KEY=... node scripts/fix-loops-from-email.mjs
#    Optional SMTP JSON template setup: LOOPS_API_KEY=... node scripts/setup-loops-supabase-email.mjs
# 3) Apply SQL migrations: from this folder run `supabase db push` when your network supports IPv4 to the DB host.
#    If the CLI fails with IPv6 errors, open SQL Editor and run the files in supabase/migrations in name order.
