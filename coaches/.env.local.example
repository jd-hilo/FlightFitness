# Same Supabase project as the Expo app (see root .env / EAS secrets).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never commit real values. Used for cross-user reads/writes and coach messages.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase auth user UUIDs allowed to use this dashboard (Jude’s account).
COACH_ALLOWED_USER_IDS=
